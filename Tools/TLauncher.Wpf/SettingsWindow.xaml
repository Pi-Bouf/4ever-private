<Window x:Class="TLauncher.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="440" Height="560"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#FF16171A" FontFamily="Segoe UI" MouseLeftButtonDown="Drag">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD6D8DD" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8B24A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD6D8DD" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF3A3E45" BorderThickness="1">
        <DockPanel Margin="0">
            <Border DockPanel.Dock="Top" Background="#FF202227" Height="42">
                <Grid>
                    <TextBlock Text="OPTIONS" Foreground="#FFE8B24A" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center" Margin="16,0" />
                    <Button Content="✕" Click="Cancel_Click" HorizontalAlignment="Right" Width="42" Height="42"
                            Background="Transparent" Foreground="#FFB9BEC7" BorderThickness="0" Cursor="Hand" FontSize="14" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="#FF202227" Height="56">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="Save" Click="Save_Click" Width="96" Height="32" Margin="0,0,8,0"
                            Background="#FFE8B24A" Foreground="#FF16171A" BorderThickness="0" FontWeight="Bold" Cursor="Hand" />
                    <Button Content="Cancel" Click="Cancel_Click" Width="90" Height="32"
                            Background="#FF2A2D33" Foreground="#FFECEEF2" BorderBrush="#FF3A3E45" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,10">
                <StackPanel>
                    <TextBlock Text="DISPLAY" Style="{StaticResource H}" />
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Resolution" />
                        <ComboBox x:Name="ResoCombo" Grid.Column="1" />
                    </Grid>
                    <CheckBox x:Name="WindowedChk" Content="Windowed mode" Margin="0,8,0,0" />
                    <CheckBox x:Name="ShaderChk" Content="Use shaders" />

                    <TextBlock Text="QUALITY" Style="{StaticResource H}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Texture detail" />
                        <ComboBox x:Name="TexCombo" Grid.Row="0" Grid.Column="1" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Map detail" />
                        <ComboBox x:Name="MapCombo" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="Object detail" />
                        <ComboBox x:Name="ObjCombo" Grid.Row="2" Grid.Column="1" Margin="0,2" />
                    </Grid>
                    <CheckBox x:Name="MapShadowChk" Content="Map shadows" Margin="0,8,0,0" />
                    <CheckBox x:Name="ObjShadowChk" Content="Object shadows" />

                    <TextBlock Text="AUDIO" Style="{StaticResource H}" />
                    <CheckBox x:Name="MasterChk" Content="Master sound" />
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <Slider x:Name="MasterSlider" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock x:Name="MasterVal" Grid.Column="1" HorizontalAlignment="Right" />
                    </Grid>
                    <CheckBox x:Name="BgmChk" Content="Background music" Margin="0,6,0,0" />
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <Slider x:Name="BgmSlider" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock x:Name="BgmVal" Grid.Column="1" HorizontalAlignment="Right" />
                    </Grid>
                    <CheckBox x:Name="SfxChk" Content="Sound effects" Margin="0,6,0,0" />
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <Slider x:Name="SfxSlider" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock x:Name="SfxVal" Grid.Column="1" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
