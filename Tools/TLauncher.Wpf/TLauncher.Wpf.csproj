<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TLauncher.Wpf</RootNamespace>
    <AssemblyName>TLauncher.Wpf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TLauncher.Core\TLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The launcher's own skin bitmaps, bundled as WPF resources. -->
    <Resource Include="Assets\*.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
